# Same-origin, not CORS: proxies /v1/* to fantasy-core-pipeline's in-cluster Service so
# the SPA never needs to know it's a different backend - mirrors vite.config.ts's dev
# proxy, just at the production edge instead of Vite's dev server.
map $status $loglevel {
    ~^5 error;
    ~^4 warn;
    default info;
}

map $http_user_agent $loggable {
    ~^kube-probe 0;
    default 1;
}

log_format json escape=json
    '{"msg":"$request","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time,"upstream":"$upstream_addr",'
    '"user_agent":"$http_user_agent","remote_addr":"$remote_addr",'
    '"level":"$loglevel"}';

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log json if=$loggable;

    # Points at this cluster's CoreDNS ClusterIP directly (confirmed via
    # `kubectl get svc -n kube-system coredns` - 10.152.183.152 on this cluster; re-check
    # if this ever gets redeployed onto a different cluster). Resolving the upstream via a
    # variable, not a literal proxy_pass target, defers DNS lookup to request time rather
    # than nginx config load/startup - a literal hostname there gets resolved once at
    # startup and fails to boot the whole container (serving the static SPA too) if the
    # backend Service isn't resolvable at that exact moment - confirmed locally: the
    # literal form crash-loops outside the cluster with "host not found in upstream".
    resolver 10.152.183.152 valid=10s;
    set $backend "${CORE_API_UPSTREAM}";

    location ~ ^/v1/trigger/(waiver|lineup|draft-pick)$ {
        limit_except POST { deny all; }
        proxy_set_header X-API-Key "${TRIGGER_API_KEY}";
        proxy_pass http://$backend$request_uri;
        proxy_intercept_errors on;
        error_page 401 = @waiver_auth_error;
    }

    location ~ ^/v1/trade/incoming/[^/]+/(triage|decision|decision/retry|counter)$ {
        limit_except POST { deny all; }
        proxy_set_header X-API-Key "${TRIGGER_API_KEY}";
        proxy_pass http://$backend$request_uri;
        proxy_intercept_errors on;
        error_page 401 = @inbox_auth_error;
    }

    location @inbox_auth_error {
        default_type application/json;
        return 502 '{"detail":"Inbox service authentication failed. Contact an administrator."}';
    }

    location @waiver_auth_error {
        default_type application/json;
        return 502 '{"detail":"Claim service authentication failed. Contact an administrator."}';
    }

    location /v1/ {
        # $request_uri (the literal incoming path+query, e.g. "/v1/health"), not a
        # trailing "/v1/" on proxy_pass itself - when proxy_pass's target contains a
        # variable, nginx does NOT do its usual location-prefix path merging, so a
        # literal "/v1/" here would proxy every request to that same bare path
        # regardless of what came after it (confirmed live: /v1/health 404'd because
        # only "/v1/" ever reached the backend). $request_uri sidesteps that entirely
        # since frontend and backend paths are identical here - no prefix stripping needed.
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        # GET /v1/draft/stream is a long-lived SSE connection - buffering would hold
        # events until nginx's buffer filled instead of forwarding them as they arrive,
        # and the default proxy_read_timeout (60s) would kill an idle-but-healthy stream
        # well before the backend's own 2s poll interval could reasonably go quiet.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri /index.html;
    }
}
